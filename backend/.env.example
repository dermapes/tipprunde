PORT=3000
# URL der GitHub-Pages-App ohne abschließenden Slash
CORS_ORIGIN=https://dermapes.github.io

# Mit `npx web-push generate-vapid-keys` erzeugen
VAPID_SUBJECT=mailto:deine-email@example.com
PUBLIC_VAPID_KEY=
PRIVATE_VAPID_KEY=

# Geheimer Token für Admin-Endpunkte
ADMIN_TOKEN=bitte-einen-langen-zufaelligen-token-setzen

# Optional: Speicherort für Subscription-Daten
SUBSCRIPTIONS_FILE=./data/subscriptions.json
